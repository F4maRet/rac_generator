# Python
venv/
__pycache__/
*.pyc

# Секреты: пароль приложения и прочие настройки
.env

# Данные программы НЕ кладём в репозиторий: база (в ней API-ключи и данные
# авторов, включая служебные файлы SQLite app.db-wal / app.db-shm),
# сгенерированные документы и загруженный шаблон. Сохраняем только пустую
# структуру папок.
data/*
!data/output/
data/output/*
!data/output/.gitkeep
